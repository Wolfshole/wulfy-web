---
import { validateSession } from '../lib/kv';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Wulfy Web', description = 'Willkommen bei Wulfy Web' } = Astro.props;

// Session-Validierung
const sessionId = Astro.cookies.get('session_id')?.value;
let user = null;

if (sessionId) {
  user = await validateSession(sessionId);
}
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="stylesheet" href="/src/styles/base.css">
  <link rel="stylesheet" href="/src/styles/nightmode.css">
  <style>
    .auth-nav {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .auth-nav button, .auth-nav a {
      padding: 8px 16px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
    }
    .btn-login {
      background: #4a90e2;
      color: white;
    }
    .btn-login:hover {
      background: #357abd;
    }
    .btn-register {
      background: transparent;
      color: #4a90e2;
      border: 2px solid #4a90e2;
    }
    .btn-register:hover {
      background: #4a90e2;
      color: white;
    }
    .btn-dashboard {
      background: #28a745;
      color: white;
    }
    .btn-dashboard:hover {
      background: #218838;
    }
    .btn-logout {
      background: #dc3545;
      color: white;
    }
    .btn-logout:hover {
      background: #c82333;
    }
    .user-greeting {
      color: #ffffff;
      font-weight: 600;
      margin-right: 10px;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    #auth-buttons {
      display: flex;
      gap: 10px;
    }
    #user-menu {
      display: none;
      align-items: center;
      gap: 10px;
    }
    .btn-profile {
      background: #f5f5f5;
      color: #4a90e2;
      border: 2px solid #4a90e2;
      margin-left: 5px;
    }
    .btn-profile:hover {
      background: #4a90e2;
      color: #fff;
  </style>
</head>
<body>
  <!-- Auth Navigation -->
  <div class="auth-nav">
    {!user && (
    <div id="auth-buttons">
      <a href="/login" class="btn-login">Anmelden</a>
      <a href="/register" class="btn-register">Registrieren</a>
    </div>
    )}
    {user && (
    <div id="user-menu" style="display: flex;">
      <span class="user-greeting">Hallo, <span id="nav-username">{user.username}</span>!</span>
      {user.isAdmin && <a href="/dashboard" class="btn-dashboard">Dashboard</a>}
      <a href="/profile" class="btn-profile">Profil</a>
      <a href="/api/auth/logout" class="btn-logout">Abmelden</a>
    </div>
    )}
  </div>

  <main class="main-content">
    <slot />
  </main>

  <script>
    // Navigation wird jetzt serverseitig gerendert
    // Kein LocalStorage-Check mehr nötig
    
    // Theme Toggle (falls vorhanden)
    const themeToggle = document.getElementById('nightModeBtn');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        document.body.classList.toggle('dark-mode');
        localStorage.setItem('theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');
      });
    }

    // Load saved theme
    if (localStorage.getItem('theme') === 'dark') {
      document.body.classList.add('dark-mode');
    }
  </script>
</body>
</html>