---
import CleanLayout from "../layouts/CleanLayout.astro";
import EmailVerificationBanner from "../components/EmailVerificationBanner.astro";
import { validateSession } from "../lib/kv";
import "../styles/dashboard.css";
import "../styles/nightmode.css";
import "../styles/profile.css";
import "../styles/responsive-utilities.css";
import "../styles/translate.css";

// Session-Validierung
const sessionId = Astro.cookies.get('session_id')?.value;
let user = null;

if (sessionId) {
  user = await validateSession(sessionId);
}

// Redirect wenn nicht eingeloggt
if (!user) {
  return Astro.redirect('/login');
}
---

<CleanLayout title="Mein Profil">
  <body>
	<main class="dashboard-container">
	  <!-- E-Mail-Verifikations-Banner -->
	  <EmailVerificationBanner email={user.email} verified={user.emailVerified || false} />
	  
	  <div class="dashboard-header">
		<h1>Mein Profil 👤</h1>
		<p>Verwalte deine Profilinformationen</p>
	  </div>

	  <div id="message" class="message"></div>

	  <div class="dashboard-content">
		<div class="dashboard-card profile-picture-section">
		  <h2>Profilbild</h2>
		  
		  <div class="profile-picture-container" id="profile-picture-container">
			<!-- Profilbild wird hier dynamisch eingefügt -->
		  </div>

		  <div class="upload-controls">
			<label for="profile-picture-input" class="file-input-label">
			  📷 Bild auswählen
			</label>
			<input 
			  type="file" 
			  id="profile-picture-input" 
			  accept="image/*"
			/>
			<button id="remove-picture-btn" class="btn-remove" style="display: none;">
			  🗑️ Bild entfernen
			</button>
		  </div>
		</div>

		<div class="dashboard-card profile-info-section">
		  <h2>Deine Informationen</h2>
		  <div class="info-item">
			<span class="info-label">Benutzername:</span>
			<span class="info-value" id="profile-username">{user.username}</span>
		  </div>
		  <div class="info-item">
			<span class="info-label">E-Mail:</span>
			<span class="info-value" id="profile-email">{user.email}</span>
			{user.emailVerified && <span style="color: #48bb78; margin-left: 8px;">✓ Bestätigt</span>}
			{!user.emailVerified && <span style="color: #f56565; margin-left: 8px;">⚠ Nicht bestätigt</span>}
		  </div>
		  <div class="info-item">
			<span class="info-label">Registriert seit:</span>
			<span class="info-value" id="profile-registered">{new Date(user.createdAt).toLocaleDateString('de-DE')}</span>
		  </div>
		  {user.isAdmin && (
		  <div class="info-item">
			<span class="info-label">Status:</span>
			<span class="info-value" style="color: #f39c12; font-weight: bold;">👑 Administrator</span>
		  </div>
		  )}
		</div>
	  </div>
	</main>

	<footer class="footer">
		<div class="container">
			<div class="footer-content">
				<div class="footer-section">
					<h3 data-translate="footer-quick-links">Schnellzugriff</h3>
					<ul>
						<li><a href="/" data-translate="nav-home">Startseite</a></li>
						<li><a href="/about" data-translate="nav-about">Über mich</a></li>
						<li><a href="/projects" data-translate="nav-projects">Projekte</a></li>
						<li><a href="/failed_and_newly_started_projects" data-translate="nav-failed-projects">Gescheiterte und neu gestartete Projekte</a></li>
						<li><a href="/faq" data-translate="nav-faq">FAQ</a></li>
						<li><a href="/cfw_download" data-translate="nav-cfw-download">CFW Download</a></li>
					</ul>
				</div>
				<div class="footer-section">
					<h3 data-translate="footer-legal">Rechtliches</h3>
					<ul>
						<li><a href="/impressum" data-translate="footer-impressum">Impressum</a></li>
						<li><a href="/datenschutz" data-translate="footer-privacy">Datenschutz</a></li>
					</ul>
				</div>
				<div class="footer-section">
					<h3 data-translate="footer-contact">Kontakt</h3>
					<p>
						<span data-translate="footer-email">E-Mail:</span> 
						<a href="mailto:wulfghg@gmail.com">wulfghg@gmail.com</a>
					</p>
				</div>
			</div>
			<div class="footer-bottom">
				<p data-translate="footer-copyright">&copy; 2026 Wulfy. Alle Rechte vorbehalten.</p>
			</div>
		</div>
	</footer>

	<script src="../scripts/nightmode.js"></script>
	<script src="../scripts/profile.js"></script>
  </body>
</CleanLayout>

